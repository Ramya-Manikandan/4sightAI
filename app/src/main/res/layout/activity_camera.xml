<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".CameraActivity">

    <!-- Camera Output Underneath Everything -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AI Bounding Box Overlay -->
    <com.foursightai.BoundingBoxOverlay
        android:id="@+id/boundingBoxOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Floating Header -->
    <LinearLayout
        android:id="@+id/headerOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4Sight AI — Active Navigation"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Bottom Container Block -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Status Indicator -->
        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvSubtitleArea">
            
            <View
                android:id="@+id/indicatorDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/indicator_green" />
                
            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF"
                android:text="Navigation Active"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Rounded Semi-Transparent Subtitles -->
        <TextView
            android:id="@+id/tvSubtitleArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="@drawable/bg_subtitle"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:gravity="center"
            android:text="Initializing AI Environment..."
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@id/btnToggleNavigation" />

        <!-- High Visibility Rounded Pill Button -->
        <Button
            android:id="@+id/btnToggleNavigation"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent="0.7"
            android:layout_height="70dp"
            android:text="STOP NAVIGATION"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="8dp"
            android:background="@drawable/bg_stop_button"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
